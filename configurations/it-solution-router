enable
configure terminal
hostname IT_Solution
interface serial 0/1/1
description #Connection from ISP#
ip address 16.245.239.6 255.255.255.252
no shutdown
interface gig0/0/0
no shutdown
interface gig0/0/0.2
encapsulation dot1q 2
description #vlan 2 wired lan configure#
ip address 192.168.2.1 255.255.255.128
interface gig0/0/0.3
encapsulation dot1q 3
description #vlan 3 wireless client configure#
ip address 192.168.2.254 255.255.255.128

!DHCP configure
ip dhcp pool wiredLan
network 192.168.2.0 255.255.255.128
default-router 192.168.2.1
dns 1.1.1.1
domain cisco

ip dhcp pool wirelessClient
network 192.168.2.128 255.255.255.128
default-router 192.168.2.254
dns 1.1.1.1
domain cisco

!default route config
ip route 0.0.0.0 0.0.0.0 16.245.239.5
